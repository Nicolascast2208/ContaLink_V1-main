{
  "expo": {
    "name": "Rindefy",
    "slug": "Rindefy",
    "scheme": "rindefy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/rindefy_logo_app.png",
    "backgroundColor": "#FFFFFF",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "backgroundColor": "#FFFFFF",
      "supportsTablet": true,
      "bundleIdentifier": "com.nicolascastillo.ContaLinkApp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/rindefy_logo_app.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/rindefy_logo_app.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/rindefy_logo_app.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}